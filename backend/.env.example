# Copy to backend/.env (or the repo-root .env). Real env vars override both.
LLM_PROVIDER=groq              # gemini | groq | openai | mock
LLM_FALLBACK=gemini            # optional; any provider other than the primary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
CORS_ORIGINS=http://localhost:5173
ALLOW_FAULTS=true
RATE_LIMIT_PER_MIN=10
TOTAL_TIMEOUT_S=40
PROVIDER_TIMEOUT_S=25
LOG_LEVEL=INFO
